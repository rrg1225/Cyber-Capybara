{
  "name": "desktop-pet-core",
  "version": "1.0.0",
  "description": "卡皮巴拉桌宠",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder"
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^35.7.5",
    "electron-builder": "^24.13.3",
    "vite": "^6.4.2"
  },
  "build": {
    "appId": "com.desktop.capybara",
    "productName": "卡皮巴拉桌宠",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}